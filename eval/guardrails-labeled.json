{
  "description": "dsh-guardrails 命令分类器的人工标注集。expect: dangerous=必须走人工审批 / mutating=自动台账 / readonly=放行。陷阱用例检验锚定语义（引号/注释内的危险字样不得升级为 dangerous；&& 链与 xargs/find -exec/sh -c 包装后的危险命令不得漏报）。改动分类正则可，但必须同步更新本文件并说明理由——这就是分类行为的契约。",
  "knownLimitations": [
    "heredoc 体内每行会被当作命令位：git commit -m \"$(cat <<'EOF'\nrm -rf x\nEOF)\" 里的消息文本若以 rm -rf 起行会误报 dangerous。根因是没有 shell 解析器，锚定无法区分命令与数据；方向是保守（要求审批而非放行），可接受，暂不修。"
  ],
  "cases": [
    {
      "command": "ls -la",
      "expect": "readonly"
    },
    {
      "command": "cat README.md",
      "expect": "readonly"
    },
    {
      "command": "git status",
      "expect": "readonly"
    },
    {
      "command": "git log --oneline -10",
      "expect": "readonly"
    },
    {
      "command": "node test.js",
      "expect": "readonly",
      "note": "任意脚本执行在分类契约里视为只读（沙箱是 DSH 的责任）"
    },
    {
      "command": "sleep 8",
      "expect": "readonly"
    },
    {
      "command": "curl https://example.com/api",
      "expect": "readonly",
      "note": "GET 只读"
    },
    {
      "command": "printf '%s' 'rm -rf /'",
      "expect": "mutating",
      "note": "陷阱：引号内字样不得升级为 dangerous（锚定层豁免），但 mutating 层刻意不锚定——保守入账是设计内的可接受误报"
    },
    {
      "command": "echo 'sudo reboot' > note.txt",
      "expect": "mutating",
      "note": "陷阱：有重定向写入所以是 mutating，但引号内 sudo 不得升级为 dangerous"
    },
    {
      "command": "grep -rn 'git push' src/",
      "expect": "readonly",
      "note": "陷阱：搜索文本里的 git push"
    },
    {
      "command": "bash -c 'echo hello'",
      "expect": "readonly",
      "note": "sh -c 包装但内核安全"
    },
    {
      "command": "rm old-notes.txt",
      "expect": "mutating",
      "note": "裸 rm 入账但不升级审批（无 -r/-f 递归强删标志）"
    },
    {
      "command": "echo hello > out.txt",
      "expect": "mutating"
    },
    {
      "command": "mkdir -p a/b/c",
      "expect": "mutating"
    },
    {
      "command": "touch .gitignore",
      "expect": "mutating"
    },
    {
      "command": "cp -r src/ backup/",
      "expect": "mutating"
    },
    {
      "command": "mv old.js new.js",
      "expect": "mutating"
    },
    {
      "command": "chmod +x run.sh",
      "expect": "mutating"
    },
    {
      "command": "ln -s target link",
      "expect": "mutating"
    },
    {
      "command": "sed -i '' 's/foo/bar/' file.js",
      "expect": "mutating"
    },
    {
      "command": "sed -n '1,5p' file.js",
      "expect": "readonly",
      "note": "sed 无 -i 是只读"
    },
    {
      "command": "git add .",
      "expect": "mutating"
    },
    {
      "command": "git commit -m 'fix'",
      "expect": "mutating"
    },
    {
      "command": "git checkout -b feat/x",
      "expect": "mutating"
    },
    {
      "command": "npm install lodash",
      "expect": "mutating"
    },
    {
      "command": "pnpm add -D esbuild",
      "expect": "mutating"
    },
    {
      "command": "rm -rf /tmp/scratch",
      "expect": "dangerous"
    },
    {
      "command": "rm -f node_modules/.cache/x",
      "expect": "dangerous"
    },
    {
      "command": "true && rm -rf build",
      "expect": "dangerous",
      "note": "&& 链后的危险命令必须命中"
    },
    {
      "command": "ls | xargs rm -rf",
      "expect": "dangerous",
      "note": "xargs 包装绕过（标注集实测抓出的漏报）"
    },
    {
      "command": "printf 'a\\nb\\n' | xargs rm -f",
      "expect": "dangerous",
      "note": "xargs 包装 rm -f"
    },
    {
      "command": "find . -name '*.log' -exec rm -f {} +",
      "expect": "dangerous",
      "note": "find -exec 包装绕过"
    },
    {
      "command": "sh -c 'rm -rf /tmp/x'",
      "expect": "dangerous",
      "note": "sh -c 子壳包装绕过"
    },
    {
      "command": "git push origin main",
      "expect": "dangerous"
    },
    {
      "command": "git reset --hard HEAD~1",
      "expect": "dangerous"
    },
    {
      "command": "npm publish",
      "expect": "dangerous"
    },
    {
      "command": "yarn publish --access public",
      "expect": "dangerous"
    },
    {
      "command": "sudo apt-get update",
      "expect": "dangerous"
    },
    {
      "command": "shutdown -h now",
      "expect": "dangerous"
    },
    {
      "command": "kill -9 4242",
      "expect": "dangerous"
    },
    {
      "command": "killall -9 node",
      "expect": "dangerous"
    },
    {
      "command": "curl -X POST https://api.example.com/deploy -d '{}'",
      "expect": "dangerous"
    },
    {
      "command": "curl -XPUT https://api.example.com/doc/1",
      "expect": "dangerous",
      "note": "-X 与方法连写也要命中"
    },
    {
      "command": "echo $(git push)",
      "expect": "dangerous",
      "note": "命令替换内的危险命令不得逃逸（锚点已含 $( 与反引号）"
    },
    {
      "command": "echo `sudo whoami`",
      "expect": "dangerous",
      "note": "反引号替换同样"
    },
    {
      "command": "git -C /tmp/repo push",
      "expect": "dangerous",
      "note": "git 全局选项（-C）不得隐藏子命令"
    },
    {
      "command": "git -c core.x=y push origin main",
      "expect": "dangerous",
      "note": "-c 配置选项同理"
    },
    {
      "command": "git -C /tmp/repo reset --hard",
      "expect": "dangerous",
      "note": "-C + reset --hard"
    },
    {
      "command": "git -C /tmp/repo commit -m x",
      "expect": "mutating",
      "note": "-C + commit 入账"
    }
  ],
  "allowlistCases": {
    "description": "白名单语义：strict 列为默认（无白名单）预期，allowlisted 列为启用预设后的预期。预设锚定全串，任何分隔符/替换符都会失配——链式命令不得借白名单洗白。",
    "preset": "ALLOW_GIT_PUSH_SAFE",
    "cases": [
      {
        "command": "git push origin main",
        "strict": "dangerous",
        "allowlisted": "mutating"
      },
      {
        "command": "git push",
        "strict": "dangerous",
        "allowlisted": "mutating"
      },
      {
        "command": "git push -u origin main",
        "strict": "dangerous",
        "allowlisted": "mutating"
      },
      {
        "command": "git push --tags",
        "strict": "dangerous",
        "allowlisted": "mutating"
      },
      {
        "command": "git push https://github.com/smile-xuc/DSH-MUSE.git main",
        "strict": "dangerous",
        "allowlisted": "mutating"
      },
      {
        "command": "git push --force origin main",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "强推不入白名单"
      },
      {
        "command": "git push -f",
        "strict": "dangerous",
        "allowlisted": "dangerous"
      },
      {
        "command": "git push -uf origin main",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "组合旗标含 f 也算"
      },
      {
        "command": "git push --delete origin feat",
        "strict": "dangerous",
        "allowlisted": "dangerous"
      },
      {
        "command": "git push --mirror",
        "strict": "dangerous",
        "allowlisted": "dangerous"
      },
      {
        "command": "git push --force-with-lease",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "保守：lease 变体仍走审批"
      },
      {
        "command": "git push origin main; rm -rf /tmp/x",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "反清洗：链式命令整体不享受白名单"
      },
      {
        "command": "git pull && git push",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "含分隔符即失配，保守"
      },
      {
        "command": "echo $(git push)",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "命令替换内不算独立 push"
      },
      {
        "command": "git -C /tmp/repo push origin main",
        "strict": "dangerous",
        "allowlisted": "mutating",
        "note": "-C 全局选项下的安全 push 同样降级"
      },
      {
        "command": "git -C /tmp/repo push --force",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "-C + 强推保持门控"
      },
      {
        "command": "cd ~/Documents/Coder/yuanzhi-app && git push origin main",
        "strict": "dangerous",
        "allowlisted": "mutating",
        "note": "cd 前缀惯例同样降级"
      },
      {
        "command": "cd /tmp/x && git push",
        "strict": "dangerous",
        "allowlisted": "mutating"
      },
      {
        "command": "cd $(rm -rf /tmp/x) && git push",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "cd 参数含命令替换不得洗白"
      },
      {
        "command": "cd /tmp/x && git push --force",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "cd 前缀+强推保持门控"
      },
      {
        "command": "cd /tmp/x && git push origin main; rm -rf /tmp/y",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "尾部分隔符保持门控"
      },
      {
        "command": "cd /tmp/x && git push && rm -rf /tmp/y",
        "strict": "dangerous",
        "allowlisted": "dangerous",
        "note": "尾部 && 保持门控"
      }
    ]
  }
}
