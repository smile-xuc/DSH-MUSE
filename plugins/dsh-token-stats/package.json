{
  "name": "dsh-token-stats",
  "version": "0.1.0",
  "private": true,
  "description": "Token usage statistics for the DeepSeek Harness web UI: daily/weekly totals in the sidebar foot (above Settings) plus a full per-day history modal, aggregated from every durable session log via ctx.sessionPersistence.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-persistence": "^0.1.1-rc.2"
  }
}
